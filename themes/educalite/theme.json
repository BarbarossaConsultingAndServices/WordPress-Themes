{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "base", "color": "#FFFFFF", "name": "Base" },
        { "slug": "contrast", "color": "#0F172A", "name": "Ink" },
        { "slug": "primary", "color": "#059669", "name": "Emerald" },
        { "slug": "primary-soft", "color": "#D1FAE5", "name": "Mint" },
        { "slug": "secondary", "color": "#F59E0B", "name": "Amber" },
        { "slug": "muted", "color": "#64748B", "name": "Slate" },
        { "slug": "surface", "color": "#F0FDF4", "name": "Surface" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        { "slug": "jakarta", "name": "Plus Jakarta Sans", "fontFamily": "'Plus Jakarta Sans', Inter, system-ui, sans-serif" },
        { "slug": "system", "name": "System", "fontFamily": "system-ui, sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large" },
        { "slug": "x-large", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2rem" }, "name": "XL" },
        { "slug": "xx-large", "size": "3rem", "fluid": { "min": "2rem", "max": "3rem" }, "name": "XXL" },
        { "slug": "hero", "size": "3.75rem", "fluid": { "min": "2.5rem", "max": "3.75rem" }, "name": "Hero" }
      ]
    },
    "spacing": {
      "spacingSizes": [
        { "slug": "20", "size": "0.5rem", "name": "XS" },
        { "slug": "30", "size": "1rem", "name": "S" },
        { "slug": "40", "size": "1.5rem", "name": "M" },
        { "slug": "50", "size": "2.5rem", "name": "L" },
        { "slug": "60", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4rem" }, "name": "XL" },
        { "slug": "70", "size": "6rem", "fluid": { "min": "4rem", "max": "6rem" }, "name": "XXL" }
      ]
    },
    "layout": { "contentSize": "1200px", "wideSize": "1280px" },
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "shadow": {
      "presets": [
        { "slug": "card", "name": "Card", "shadow": "0 1px 3px rgba(15,23,42,.08)" },
        { "slug": "lift", "name": "Lift", "shadow": "0 12px 32px -12px rgba(5,150,105,.25)" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--jakarta)", "lineHeight": "1.6" },
    "elements": {
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--hero)", "lineHeight": "1.05" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.15" } },
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--primary)", "text": "#FFFFFF" },
        "border": { "radius": "12px" },
        "spacing": { "padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.4rem", "right": "1.4rem" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" },
    { "name": "comments", "title": "Comments", "area": "uncategorized" }
  ],
  "customTemplates": [{ "name": "page-no-title", "title": "Page (no title)", "postTypes": ["page"] }]
}
