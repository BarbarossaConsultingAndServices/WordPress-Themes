{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Minimal Light",
  "settings": {
    "color": {
      "palette": [
        { "slug": "base", "color": "#FFFFFF", "name": "Base" },
        { "slug": "contrast", "color": "#1C1917", "name": "Stone ink" },
        { "slug": "primary", "color": "#1C1917", "name": "Mono" },
        { "slug": "primary-soft", "color": "#F5F5F4", "name": "Stone soft" },
        { "slug": "secondary", "color": "#78716C", "name": "Stone" },
        { "slug": "muted", "color": "#78716C", "name": "Muted" },
        { "slug": "surface", "color": "#FAFAF9", "name": "Surface" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" }
  }
}
