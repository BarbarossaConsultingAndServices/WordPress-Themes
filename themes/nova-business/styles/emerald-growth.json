{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Emerald Growth",
  "settings": {
    "color": {
      "palette": [
        { "slug": "base", "color": "#FFFFFF", "name": "Base" },
        { "slug": "contrast", "color": "#052E22", "name": "Deep green ink" },
        { "slug": "primary", "color": "#059669", "name": "Emerald" },
        { "slug": "primary-soft", "color": "#D1FAE5", "name": "Mint" },
        { "slug": "secondary", "color": "#0D9488", "name": "Teal" },
        { "slug": "muted", "color": "#5F6F65", "name": "Muted" },
        { "slug": "surface", "color": "#ECFDF5", "name": "Surface" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "elements": {
      "button": { "color": { "background": "var(--wp--preset--color--primary)", "text": "#FFFFFF" } },
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } }
    }
  }
}
