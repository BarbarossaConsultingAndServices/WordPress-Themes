{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Navy Trust",
  "settings": {
    "color": {
      "palette": [
        { "slug": "base", "color": "#FFFFFF", "name": "Base" },
        { "slug": "contrast", "color": "#0B1F3A", "name": "Navy ink" },
        { "slug": "primary", "color": "#2563EB", "name": "Trust blue" },
        { "slug": "primary-soft", "color": "#DBEAFE", "name": "Blue soft" },
        { "slug": "secondary", "color": "#0EA5E9", "name": "Sky" },
        { "slug": "muted", "color": "#5B6B82", "name": "Muted" },
        { "slug": "surface", "color": "#EFF6FF", "name": "Surface" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "elements": {
      "button": {
        "color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--base)" }
      },
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } }
    }
  }
}
