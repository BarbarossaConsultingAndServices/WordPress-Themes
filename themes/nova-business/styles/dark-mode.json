{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Dark Mode",
  "settings": {
    "color": {
      "palette": [
        { "slug": "base", "color": "#0F172A", "name": "Dark base" },
        { "slug": "contrast", "color": "#F1F5F9", "name": "Light ink" },
        { "slug": "primary", "color": "#818CF8", "name": "Indigo light" },
        { "slug": "primary-soft", "color": "#1E1B4B", "name": "Indigo deep" },
        { "slug": "secondary", "color": "#38BDF8", "name": "Sky light" },
        { "slug": "muted", "color": "#94A3B8", "name": "Muted" },
        { "slug": "surface", "color": "#1E293B", "name": "Surface dark" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "elements": {
      "button": { "color": { "background": "var(--wp--preset--color--primary)", "text": "#0F172A" } },
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } }
    }
  }
}
