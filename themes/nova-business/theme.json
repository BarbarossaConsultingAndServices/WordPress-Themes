{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "base", "color": "#FFFFFF", "name": "Base (white)" },
        { "slug": "contrast", "color": "#0F172A", "name": "Ink" },
        { "slug": "primary", "color": "#4F46E5", "name": "Indigo" },
        { "slug": "primary-soft", "color": "#E0E7FF", "name": "Indigo soft" },
        { "slug": "secondary", "color": "#0EA5E9", "name": "Sky" },
        { "slug": "muted", "color": "#64748B", "name": "Slate" },
        { "slug": "surface", "color": "#F8FAFC", "name": "Surface" }
      ],
      "duotone": [
        {
          "slug": "indigo-slate",
          "colors": ["#4F46E5", "#F8FAFC"],
          "name": "Indigo duotone"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "inter",
          "name": "Inter",
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "fontFace": []
        },
        {
          "slug": "system",
          "name": "System",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large" },
        { "slug": "x-large", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2rem" }, "name": "XL" },
        { "slug": "xx-large", "size": "3rem", "fluid": { "min": "2rem", "max": "3rem" }, "name": "XXL" },
        { "slug": "hero", "size": "3.75rem", "fluid": { "min": "2.5rem", "max": "3.75rem" }, "name": "Hero" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%"],
      "spacingScale": { "operator": "*", "increment": 1.5, "steps": 7, "mediumStep": 1.5, "unit": "rem" },
      "spacingSizes": [
        { "slug": "20", "size": "0.5rem", "name": "XS" },
        { "slug": "30", "size": "1rem", "name": "S" },
        { "slug": "40", "size": "1.5rem", "name": "M" },
        { "slug": "50", "size": "2.5rem", "name": "L" },
        { "slug": "60", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4rem" }, "name": "XL" },
        { "slug": "70", "size": "6rem", "fluid": { "min": "4rem", "max": "6rem" }, "name": "XXL" }
      ]
    },
    "layout": { "contentSize": "1200px", "wideSize": "1280px" },
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "shadow": {
      "presets": [
        { "slug": "card", "name": "Card", "shadow": "0 1px 3px rgba(15,23,42,.08)" },
        { "slug": "lift", "name": "Lift", "shadow": "0 12px 32px -12px rgba(79,70,229,.25)" }
      ]
    },
    "blocks": {
      "core/button": {
        "border": { "radius": "12px" },
        "color": { "palette": [] }
      }
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--inter)", "lineHeight": "1.6" },
    "spacing": { "blockGap": "1.5rem" },
    "elements": {
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--hero)", "lineHeight": "1.05", "letterSpacing": "-0.02em" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.15", "letterSpacing": "-0.01em" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.2" } },
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--base)" },
        "border": { "radius": "12px" },
        "typography": { "fontWeight": "600" },
        "spacing": { "padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.4rem", "right": "1.4rem" } }
      }
    },
    "blocks": {
      "core/group": {},
      "core/navigation": {}
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" },
    { "name": "comments", "title": "Comments", "area": "uncategorized" }
  ],
  "customTemplates": [
    { "name": "page-no-title", "title": "Page (no title)", "postTypes": ["page"] }
  ]
}
