{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "base", "color": "#FFFBF2", "name": "Cream" },
        { "slug": "contrast", "color": "#292019", "name": "Cocoa" },
        { "slug": "primary", "color": "#E0632B", "name": "Terracotta" },
        { "slug": "primary-soft", "color": "#FDEAD9", "name": "Peach" },
        { "slug": "secondary", "color": "#0E7C6B", "name": "Teal" },
        { "slug": "muted", "color": "#8A7A68", "name": "Sand" },
        { "slug": "surface", "color": "#FFFFFF", "name": "Card" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "rounded",
          "name": "Nunito fallback",
          "fontFamily": "Nunito, 'Trebuchet MS', Verdana, sans-serif"
        },
        {
          "slug": "sans",
          "name": "Inter fallback",
          "fontFamily": "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large" },
        { "slug": "x-large", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2rem" }, "name": "XL" },
        { "slug": "xx-large", "size": "3rem", "fluid": { "min": "2rem", "max": "3rem" }, "name": "XXL" },
        { "slug": "hero", "size": "3.75rem", "fluid": { "min": "2.5rem", "max": "3.75rem" }, "name": "Hero" }
      ]
    },
    "spacing": {
      "spacingSizes": [
        { "slug": "20", "size": "0.5rem", "name": "XS" },
        { "slug": "30", "size": "1rem", "name": "S" },
        { "slug": "40", "size": "1.5rem", "name": "M" },
        { "slug": "50", "size": "2.5rem", "name": "L" },
        { "slug": "60", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4rem" }, "name": "XL" },
        { "slug": "70", "size": "6rem", "fluid": { "min": "4rem", "max": "6rem" }, "name": "XXL" }
      ]
    },
    "layout": { "contentSize": "1200px", "wideSize": "1280px" },
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "shadow": {
      "presets": [
        { "slug": "card", "name": "Card", "shadow": "0 1px 3px rgba(41,32,25,.10)" },
        { "slug": "lift", "name": "Lift", "shadow": "0 16px 40px -16px rgba(224,99,43,.35)" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--rounded)", "lineHeight": "1.65" },
    "spacing": { "blockGap": "1.5rem" },
    "elements": {
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--hero)", "lineHeight": "1.05" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.15" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--primary)", "text": "#FFFBF2" },
        "border": { "radius": "999px" },
        "typography": { "fontWeight": "700" },
        "spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.6rem", "right": "1.6rem" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" },
    { "name": "comments", "title": "Comments", "area": "uncategorized" }
  ],
  "customTemplates": [
    { "name": "page-no-title", "title": "Page (no title)", "postTypes": ["page"] }
  ]
}
