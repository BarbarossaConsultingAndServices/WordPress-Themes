{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "base", "color": "#FAFAF9", "name": "Paper" },
        { "slug": "contrast", "color": "#111827", "name": "Ink" },
        { "slug": "primary", "color": "#DC2626", "name": "Signal red" },
        { "slug": "primary-soft", "color": "#FEE2E2", "name": "Red soft" },
        { "slug": "secondary", "color": "#1F2937", "name": "Graphite" },
        { "slug": "muted", "color": "#6B7280", "name": "Gray" },
        { "slug": "surface", "color": "#FFFFFF", "name": "Card" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        { "slug": "newsreader", "name": "Newsreader", "fontFamily": "Georgia, 'Times New Roman', serif" },
        { "slug": "inter", "name": "Inter", "fontFamily": "Inter, system-ui, sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large" },
        { "slug": "x-large", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2rem" }, "name": "XL" },
        { "slug": "xx-large", "size": "3rem", "fluid": { "min": "2rem", "max": "3rem" }, "name": "XXL" },
        { "slug": "hero", "size": "3.5rem", "fluid": { "min": "2.25rem", "max": "3.5rem" }, "name": "Hero" }
      ]
    },
    "spacing": {
      "spacingSizes": [
        { "slug": "20", "size": "0.5rem", "name": "XS" },
        { "slug": "30", "size": "1rem", "name": "S" },
        { "slug": "40", "size": "1.5rem", "name": "M" },
        { "slug": "50", "size": "2.5rem", "name": "L" },
        { "slug": "60", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4rem" }, "name": "XL" }
      ]
    },
    "layout": { "contentSize": "1200px", "wideSize": "1280px" },
    "border": { "color": true, "radius": true, "style": true, "width": true }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--inter)", "lineHeight": "1.6" },
    "elements": {
      "h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--newsreader)", "fontSize": "var(--wp--preset--font-size--hero)", "lineHeight": "1.05" } },
      "h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--newsreader)", "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--contrast)", "text": "var(--wp--preset--color--base)" },
        "border": { "radius": "8px" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" },
    { "name": "comments", "title": "Comments", "area": "uncategorized" }
  ],
  "customTemplates": [{ "name": "page-no-title", "title": "Page (no title)", "postTypes": ["page"] }]
}
