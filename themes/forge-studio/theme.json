{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "base", "color": "#0E0F0C", "name": "Coal" },
        { "slug": "contrast", "color": "#F4F4EC", "name": "Chalk" },
        { "slug": "primary", "color": "#C6F135", "name": "Volt" },
        { "slug": "primary-soft", "color": "#222A12", "name": "Volt deep" },
        { "slug": "secondary", "color": "#FF5C1F", "name": "Ember orange" },
        { "slug": "muted", "color": "#9AA092", "name": "Ash" },
        { "slug": "surface", "color": "#191B15", "name": "Iron" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "condensed",
          "name": "Oswald fallback",
          "fontFamily": "Oswald, 'Arial Narrow', Impact, sans-serif"
        },
        {
          "slug": "sans",
          "name": "Inter fallback",
          "fontFamily": "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large" },
        { "slug": "x-large", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2rem" }, "name": "XL" },
        { "slug": "xx-large", "size": "3rem", "fluid": { "min": "2rem", "max": "3rem" }, "name": "XXL" },
        { "slug": "hero", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4rem" }, "name": "Hero" }
      ]
    },
    "spacing": {
      "spacingSizes": [
        { "slug": "20", "size": "0.5rem", "name": "XS" },
        { "slug": "30", "size": "1rem", "name": "S" },
        { "slug": "40", "size": "1.5rem", "name": "M" },
        { "slug": "50", "size": "2.5rem", "name": "L" },
        { "slug": "60", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4rem" }, "name": "XL" },
        { "slug": "70", "size": "6rem", "fluid": { "min": "4rem", "max": "6rem" }, "name": "XXL" }
      ]
    },
    "layout": { "contentSize": "1200px", "wideSize": "1280px" },
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "shadow": {
      "presets": [
        { "slug": "card", "name": "Card", "shadow": "0 1px 3px rgba(0,0,0,.5)" },
        { "slug": "lift", "name": "Lift", "shadow": "0 16px 40px -16px rgba(198,241,53,.25)" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "lineHeight": "1.6" },
    "spacing": { "blockGap": "1.5rem" },
    "elements": {
      "h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--condensed)", "fontSize": "var(--wp--preset--font-size--hero)", "lineHeight": "1.0", "textTransform": "uppercase" } },
      "h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--condensed)", "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.05", "textTransform": "uppercase" } },
      "h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--condensed)", "fontSize": "var(--wp--preset--font-size--x-large)", "textTransform": "uppercase" } },
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--primary)", "text": "#0E0F0C" },
        "border": { "radius": "6px" },
        "typography": { "fontWeight": "800", "letterSpacing": "0.06em", "textTransform": "uppercase", "fontSize": "0.85rem" },
        "spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.8rem", "right": "1.8rem" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" },
    { "name": "comments", "title": "Comments", "area": "uncategorized" }
  ],
  "customTemplates": [
    { "name": "page-no-title", "title": "Page (no title)", "postTypes": ["page"] }
  ]
}
